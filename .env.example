# Copy to .env (gitignored). Defaults run fully offline: emulator/memory + fake LLM.
# Secrets go in secrets.env (also gitignored), e.g. for local Vertex runs with a key kept OUTSIDE the repo:
#   GOOGLE_APPLICATION_CREDENTIALS=C:\Users\<you>\.lifenest\gcp-key.json
# Cloud Run never needs a key file: it uses the service account attached by deploy.sh.
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Kuala_Lumpur

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1

# firebase = verify Firebase ID tokens; dev = "Authorization: Bearer dev:<user_id>" (refused when APP_ENV=prod)
AUTH_BACKEND=dev
FIREBASE_PROJECT_ID=
CORS_ALLOWED_ORIGINS=["http://localhost:5000","http://localhost:5173"]

# Backends: firestore|memory, gcs|local, vertex|fake
KB_BACKEND=memory
STORAGE_BACKEND=local
LLM_BACKEND=fake
# memory = no setup, data lost on restart | firestore = emulator (FIRESTORE_EMULATOR_HOST) or real project. Prod requires firestore.
DB_BACKEND=memory

FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_DATABASE=(default)

GCS_BUCKET=
DOCUMENT_TTL_HOURS=24
SESSION_TTL_HOURS=24
PUBLIC_BASE_URL=http://localhost:8000
# LOCAL_UPLOAD_SECRET=   # optional; random per process if unset

GEMINI_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=768
# With LLM_BACKEND=vertex, point this at a separate file and run scripts/ingest_kb.py once:
# KB_EMBEDDINGS_PATH=data/kb_embeddings_vertex.json
LLM_TIMEOUT_SECONDS=30

RULES_CONFIG_PATH=config/rules_my_2026_07.yaml
AGENT_MAX_STEPS=6
TOOL_TIMEOUT_SECONDS=8
TURN_TIMEOUT_SECONDS=60
# Unset = embedder default: 0.55 for Vertex text-embedding-005 (measured; the spec's 0.35 let off-topic queries
# through), 0.15 for the offline hashing embedder.
# KB_MIN_SCORE=0.55
RATE_LIMIT_PER_MINUTE=20
PENDING_ACTION_TTL_SECONDS=900
GROUNDING_CHECK=warn
