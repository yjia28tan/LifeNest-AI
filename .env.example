# Copy to .env (gitignored). Defaults run fully offline: emulator/memory + fake LLM.
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Kuala_Lumpur

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Backends: firestore|memory, gcs|local, vertex|fake
KB_BACKEND=memory
STORAGE_BACKEND=local
LLM_BACKEND=fake
# firestore (emulator or real) | memory (no emulator needed; data lost on restart)
DB_BACKEND=firestore

FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_DATABASE=(default)

GCS_BUCKET=
DOCUMENT_TTL_HOURS=24
SESSION_TTL_HOURS=24
PUBLIC_BASE_URL=http://localhost:8000
# LOCAL_UPLOAD_SECRET=   # optional; random per process if unset

GEMINI_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=768
LLM_TIMEOUT_SECONDS=30

RULES_CONFIG_PATH=config/rules_my_2026_07.yaml
AGENT_MAX_STEPS=6
TOOL_TIMEOUT_SECONDS=8
TURN_TIMEOUT_SECONDS=60
# Unset = embedder default: 0.35 for Vertex embeddings (spec), 0.15 for the offline hashing embedder.
# KB_MIN_SCORE=0.35
RATE_LIMIT_PER_MINUTE=20
PENDING_ACTION_TTL_SECONDS=900
GROUNDING_CHECK=warn
